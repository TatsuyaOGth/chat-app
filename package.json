{
  "name": "chat-app",
  "version": "0.1.0",
  "description": "Simple chat app for local LLM (Ollama)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "setup-vendor": "node scripts/setup-vendor.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit tests/security",
    "test:integration": "jest --runInBand tests/integration",
    "test:coverage": "c8 --reporter=text --reporter=lcov npm test"
  },
  "keywords": [
    "electron",
    "ollama",
    "llm",
    "chat"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "c8": "^10.1.3",
    "electron": "^41.5.0",
    "jest": "^30.2.0"
  },
  "jest": {
    "roots": [
      "<rootDir>/tests"
    ],
    "testEnvironment": "node",
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ]
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "marked": "^14.1.4",
    "highlight.js": "^11.11.1",
    "dompurify": "^3.2.2",
    "isomorphic-dompurify": "^2.18.0"
  }
}
